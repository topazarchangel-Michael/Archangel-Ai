PORT=8811
# xAI key (server-side only, never put it in the app)
XAI_API_KEY=
# 32+ random chars: openssl rand -hex 32
JWT_SECRET=
# Comma-separated tester invite codes; set REQUIRE_INVITE=true to make a code mandatory
INVITE_CODES=ARCHANGEL-TEST
REQUIRE_INVITE=false
XAI_CHAT_MODEL=grok-4.7
XAI_IMAGE_MODEL=grok-imagine-image-2.0
RATE_CHAT_PER_MIN=20
RATE_IMAGES_PER_HOUR=10
# Optional: public base URL used for image links (defaults to request origin)
PUBLIC_URL=
# Chat provider chain (first that works wins): xai, openai_compat, pollinations, ollama
CHAT_PROVIDERS=pollinations,ollama
# Image provider: pollinations (free, keyless legacy endpoint) or xai
IMAGE_PROVIDER=pollinations
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_IMAGE_MODEL=flux
# Optional Pollinations secret key (enter.pollinations.ai) if keyless access stops working
POLLINATIONS_API_KEY=
# Local Ollama (no signup). See README for setup.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=archangel-qwen2.5-1.5b
# Any OpenAI-compatible free tier, e.g. Groq: https://api.groq.com/openai/v1 + openai/gpt-oss-20b
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# ---- Monetisation ----
# test = simulated purchases (no real charge); live = only RevenueCat webhooks grant purchases
BILLING_MODE=test
BILLING_TZ=Australia/Sydney
FREE_CHATS_PER_DAY=15
FREE_IMAGES_PER_DAY=2
PRO_CHATS_PER_DAY=300
PRO_IMAGES_PER_DAY=30
CREDIT_COST_CHAT=1
CREDIT_COST_IMAGE=3
PRO_MONTHLY_BONUS_CREDITS=50
# Comma-separated emails that always get Pro free (admin grant)
ADMIN_PRO_EMAILS=
# Shared secret RevenueCat sends in the Authorization header of webhooks
REVENUECAT_WEBHOOK_AUTH=
# ---- Hosted database (optional) ----
# Leave empty to use the local SQLite file data/archangel.db. Set both to use Turso (free, no card).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# disk (default locally) or db (store images as BLOBs in the database; default when Turso is set)
IMAGE_STORE=
